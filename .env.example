# Crop Disease ML System Configuration Environment File
# Copy this file to .env and adjust variables as required.

# External Dataset Source Root Directories
PLANTVILLAGE_ROOT=data/raw/PlantVillage
PLANTDOC_ROOT=data/raw/PlantDoc
PLANTWILD_ROOT=data/raw/PlantWild
FIELD_DATA_ROOT=data/raw/FieldData

# Meteorological API Configuration
# By default, uses Open-Meteo free public API. Set custom URL or Key if using paid providers (e.g. OpenWeatherMap)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

# ML Architecture & Hyperparameters
MODEL_BACKBONE=mobilenet_v3_large
IMAGE_SIZE=224
BATCH_SIZE=32
LEARNING_RATE=0.0003
WEIGHT_DECAY=0.0001
MAX_EPOCHS=25
PATIENCE=5
MULTI_LABEL=false

# Leaf Gate & Image Quality Thresholds
BLUR_THRESHOLD=80.0
MIN_BRIGHTNESS=35.0
MAX_BRIGHTNESS=240.0
MIN_IMAGE_DIM=128
MIN_PLANT_COVERAGE=0.03

# Uncertainty Safety Thresholds
# Configurable boundary centered around 80% default target
OOD_CONFIDENCE_THRESHOLD=0.80
MAX_ENTROPY_THRESHOLD=2.20

# Versioning
MODEL_VERSION=v1.0.0
DATASET_VERSION=dataset_v1.0

